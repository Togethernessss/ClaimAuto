{
  "ConnectionStrings": {
    "DBConnection": "Data Source=(localdb)\\MSSQLLocalDB;Initial Catalog=ClaimAutoDB;Trusted_Connection=true;TrustServerCertificate=True;"
  },

  "Jwt": {
    "Key": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "Issuer": "ClaimAutoHealthSystems",
    "Audience": "ClaimAutoHealthSystems",
    "ExpireMinutes": 60
  },

  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "User": "madhavsxena@gmail.com",
    "Pass": "fiebyibbedpyhnyu",
    "FromEmail": "madhavsxena@gmail.com",
    "FromName": "ClaimAuto Health Systems"
  },

  "Frontend": {
    "BaseUrl": "http://localhost:5173"
  },

  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/claimauto-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          "fileSizeLimitBytes": 10485760,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] CorrelationId={CorrelationId} Thread={ThreadId} {Message:lj}{NewLine}{Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId", "WithCorrelationId" ],
    "Properties": {
      "Application": "ClaimAuto.HealthSystems"
    }
  },
  "AllowedHosts": "*",

  // ── One-time setup key ─────────────────────────────────────────────────────
  // Used by POST /api/setup/initialize to create the first org + admin.
  // CHANGE THIS to a strong random string before deploying to any shared environment.
  "Setup": {
    "SecretKey": "CHANGE-ME-BEFORE-DEPLOYING"
  }
}